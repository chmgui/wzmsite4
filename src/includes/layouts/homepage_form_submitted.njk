{% extends "layouts/homepage.njk" %}

        
{% block contactformsubmitted %}
   <div class="contact-area sp" id="anc_contact">
    <div class="container">
       <div class="section-title">
            <h2>{{ contact.title }}</h2>
            <p>{{ contact.description }}</p>
        </div>
        <div class="row">
              <div class="col-md-5 contact-info">
                <div class="single-info">
                    <h5>Phone (USA)</h5>
                    <p>{{ settings.phone_us }}</p>
                </div>
                <div class="single-info">
                    <h5>Phone (Singapore)</h5>
                    <p>{{ settings.phone_sg }}</p>
                </div>
                <div class="single-info">
                    <h5>Email</h5>
                    <p><a href="mailto://{{ settings.email }}">{{ settings.email }}</a></p>
                </div>
                <!--
                <div class="single-info">
                    <h5>Address (USA)</h5>
                    <p>{{ settings.address_us }}</p>
                </div>
                -->
                <div class="single-info">
                    <h5>Address</h5>
                    <p>{{ settings.address_sg }}</p>
                </div>
                
                <div class="single-info">
                    <h5>Social</h5>
                    <p>
                        {% for social in settings.socials %}
                            <a href="{{ social.url }}" class="fa fa-{{ social.name }}"> &nbsp; {{ social.name }} : {{ social.id }}</a>
                            <br>

                        {% endfor %}
                    </p>
                </div>
                
            </div>

           <div class="col-md-7">
                
                    <div class="row">
                        <div class="col-lg-12">
                        Your message has been sent.  We will reply you by the next business day.  Thank you.
                        </div>
                        <div class="col-lg-12">
                        <a href="{{ '/' | url }}#anc_contact">Click here to reset form.</a>
                        </div>
                       
                     
                    </div>
   
                <iframe name="hidden_iframe" id="hidden_iframe" style="display:none;"onload="if(submitted) '{window.location={{ '/thankyou' | url }}';}"></iframe>
                <!--
                <iframe name="hidden_iframe" id="hidden_iframe" style="display:none;" onload="if(submitted) {}"></iframe>
                -->
            </div>
        </div>
    </div>
    
</div>
{% endblock contactformsubmitted %}

